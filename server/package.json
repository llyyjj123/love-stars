{
  "name": "love-stars-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -w -p tsconfig.json",
    "test": "node --test dist/test/ledger.test.js dist/test/api.test.js dist/test/realtime.test.js dist/test/media.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "test:unit": "node --test dist/test/ledger.test.js dist/test/api.test.js dist/test/realtime.test.js dist/test/media.test.js",
    "test:db": "set ALLOW_DB_TEST_RESET=1 && node --test --test-concurrency=1 dist/test/db.test.js dist/test/outbox.test.js",
    "test:all": "npm run test && npm run test:db"
  },
  "devDependencies": {
    "@prisma/client": "^7.10.1",
    "@types/node": "^22.10.2",
    "prisma": "^7.10.1",
    "typescript": "^5.6.3"
  },
  "main": "dist/src/main.js",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1"
  }
}