# ---------- 服务端环境变量示例 ----------
# 复制为 .env 后填写；.env 已在 .gitignore 中，不会入库

# 服务
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
TZ=Asia/Shanghai

# 数据库
DATABASE_URL=postgresql://love:love@localhost:5432/love_stars?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=90d

# ---------- 预置的两个用户（无注册，只此两人） ----------
USER_A_USERNAME=a
USER_A_PASSWORD=change-me-a
USER_B_USERNAME=b
USER_B_PASSWORD=change-me-b

# ---------- 开发方管理员（控制台登录） ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# 空间（单例，固定 UUID，seed 时生成一次后不要再改）
SPACE_ID=00000000-0000-7000-8000-000000000001

# 媒体存储
MEDIA_ROOT=./data/media
MEDIA_PUBLIC_BASE=http://localhost:3000/media
MEDIA_MAX_MB=5
